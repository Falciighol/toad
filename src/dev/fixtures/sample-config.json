      "params": [],
      "headers": [],
      "cookies": [],
      "cookie_mode": "jar",
      "body": {
       "kind": "json",
       "content": "{\n  \"user\": \"{{users.name}}\"\n}",
       "fields": [],
       "variables": "",
       "file": null,
       "content_type": "",
       "gzip": false
      },
      "auth": {
       "kind": "inherit"
      },
      "values": [],
      "extract": [
       {
        "id": "x-tok",
        "var": "token",
        "source": "json",
        "expr": "$.token",
        "pick": "first",
        "index": 0,
        "default": "",
        "on_missing": "skip_iteration",
        "secret": true,
        "enabled": true
       }
      ],
      "checks": [],
      "run_if": null,
